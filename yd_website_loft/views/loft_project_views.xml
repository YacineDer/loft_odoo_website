<odoo>
    <data>

        <record id="view_loft_project_form" model="ir.ui.view">
            <field name="name">loft.project.form</field>
            <field name="model">loft.project</field>
            <field name="arch" type="xml">
                <form string="Loft Project">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Project name"/>
                            </h1>
                        </div>

                        <group>
                                <field name="sequence"/>
                                <field name="website_published"/>
                        </group>

                        <group>
                            <field name="short_description" placeholder="Short description for website"/>
                        </group>

                        <notebook>
                            <page string="Images">
                                <field name="image_ids">
                                    <list editable="bottom">
                                        <field name="sequence"/>
                                        <field name="name"/>
                                        <field name="image" widget="image" options="{'preview_image': 'image'}"/>
                                    </list>
                                    <form string="Project Image">
                                        <sheet>
                                            <group>
                                                <field name="sequence"/>
                                                <field name="name"/>
                                                <field name="image" widget="image" class="oe_avatar"/>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>



        <record id="action_loft_project" model="ir.actions.act_window">
            <field name="name">Projects</field>
            <field name="res_model">loft.project</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_loft_project"
                  name="Projects"
                  parent="website.menu_site"
                  action="action_loft_project"
                  sequence="50"/>
    </data>
</odoo>