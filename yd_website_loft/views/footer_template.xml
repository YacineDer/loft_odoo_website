<odoo>

    <template id="loft_footer_override" inherit_id="website.layout" name="Loft Footer Override">
        <xpath expr="//div[@id='footer']" position="replace">

            <div id="footer"
                 class="oe_structure oe_structure_solo text-break"
                 t-ignore="true"
                 t-if="not no_footer"
                 style="background:#f4f4f4;color:#2e465f;border-top:1px solid rgba(46,70,95,0.10);font-family:'Inter','Helvetica Neue',sans-serif;">

                <t t-call="yd_website_loft.loft_assets"/>
                <t t-set="company" t-value="website.company_id"/>

                <section style="padding:54px 0 30px;" dir="rtl" lang="ar">
                    <div style="max-width:1180px;margin:0 auto;padding:0 24px;">

                        <!-- top strip -->
                        <div class="loft-grid-4" style="display:grid;grid-template-columns:repeat(4,1fr);gap:24px;align-items:start;padding-bottom:34px;">

                            <div style="text-align:right;">
                                <div style="font-size:16px;font-weight:700;color:#2e465f;margin-bottom:14px;">كيف يمكننا مساعدتك؟</div>
                                <a href="/contactus"
                                   style="display:inline-flex;align-items:center;justify-content:center;min-width:180px;height:54px;padding:0 26px;border:none;border-radius:14px;background:linear-gradient(145deg,#2e465f 0%,#3d5874 100%);color:#ffffff;text-decoration:none;font-size:15px;font-weight:700;box-shadow:0 12px 26px rgba(46,70,95,0.20);transition:all .3s ease;">
                                    تواصل معنا
                                </a>
                            </div>

                            <div style="text-align:right;">
                                <div style="font-size:16px;font-weight:700;color:#2e465f;margin-bottom:14px;">اتصل بنا</div>
                                <a t-if="company.phone"
                                   t-att-href="'tel:%s' % company.phone"
                                   t-esc="company.phone"
                                   style="font-size:22px;font-weight:800;color:#2e465f;text-decoration:none;direction:ltr;display:inline-block;"/>
                                <span t-else="" style="font-size:18px;color:#9e9e9e;">—</span>
                            </div>

                            <div style="text-align:right;">
                                <div style="font-size:16px;font-weight:700;color:#2e465f;margin-bottom:14px;">راسلنا</div>
                                <a t-if="company.email"
                                   t-att-href="'mailto:%s' % company.email"
                                   t-esc="company.email"
                                   style="font-size:18px;font-weight:700;color:#2e465f;text-decoration:none;word-break:break-word;"/>
                                <span t-else="" style="font-size:18px;color:#9e9e9e;">—</span>
                            </div>

                            <div style="text-align:right;">
                                <div style="font-size:16px;font-weight:700;color:#2e465f;margin-bottom:14px;">تابعنا</div>
                                <div style="display:flex;gap:12px;justify-content:flex-start;flex-wrap:wrap;">

                                    <a t-if="website.social_linkedin or company.social_linkedin"
                                       t-att-href="website.social_linkedin or company.social_linkedin"
                                       target="_blank" rel="noopener noreferrer"
                                       aria-label="LinkedIn"
                                       class="loft-stat-card"
                                       style="width:44px;height:44px;display:flex;align-items:center;justify-content:center;padding:0;color:#2e465f;text-decoration:none;">
                                        <i class="fa fa-linkedin" aria-hidden="true"/>
                                    </a>

                                    <a t-if="website.social_instagram or company.social_instagram"
                                       t-att-href="website.social_instagram or company.social_instagram"
                                       target="_blank" rel="noopener noreferrer"
                                       aria-label="Instagram"
                                       class="loft-stat-card"
                                       style="width:44px;height:44px;display:flex;align-items:center;justify-content:center;padding:0;color:#2e465f;text-decoration:none;">
                                        <i class="fa fa-instagram" aria-hidden="true"/>
                                    </a>

                                    <a t-if="website.social_facebook or company.social_facebook"
                                       t-att-href="website.social_facebook or company.social_facebook"
                                       target="_blank" rel="noopener noreferrer"
                                       aria-label="Facebook"
                                       class="loft-stat-card"
                                       style="width:44px;height:44px;display:flex;align-items:center;justify-content:center;padding:0;color:#2e465f;text-decoration:none;">
                                        <i class="fa fa-facebook" aria-hidden="true"/>
                                    </a>

                                    <a t-if="website.social_twitter or company.social_twitter"
                                       t-att-href="website.social_twitter or company.social_twitter"
                                       target="_blank" rel="noopener noreferrer"
                                       aria-label="Twitter"
                                       class="loft-stat-card"
                                       style="width:44px;height:44px;display:flex;align-items:center;justify-content:center;padding:0;color:#2e465f;text-decoration:none;">
                                        <i class="fa fa-twitter" aria-hidden="true"/>
                                    </a>

                                    <a t-if="website.social_youtube or company.social_youtube"
                                       t-att-href="website.social_youtube or company.social_youtube"
                                       target="_blank" rel="noopener noreferrer"
                                       aria-label="YouTube"
                                       class="loft-stat-card"
                                       style="width:44px;height:44px;display:flex;align-items:center;justify-content:center;padding:0;color:#2e465f;text-decoration:none;">
                                        <i class="fa fa-youtube-play" aria-hidden="true"/>
                                    </a>

                                </div>
                            </div>
                        </div>

                        <div style="height:1px;background:rgba(46,70,95,0.16);margin-bottom:30px;"/>

                        <!-- bottom area -->
                        <div class="loft-grid-2" style="display:grid;grid-template-columns:0.9fr 1.1fr;gap:24px;align-items:end;">

                            <div style="text-align:right;">
                                <a href="/" style="display:inline-block;text-decoration:none;">
                                    <img src="/logo.png" alt="Loft Construction Logo"
                                         style="max-width:220px;max-height:90px;object-fit:contain;display:block;"/>
                                </a>

                                <div style="margin-top:18px;font-size:14px;color:#9e9e9e;line-height:1.8;">
                                    <span>Copyright © </span>
                                    <span t-esc="company.name"/>
                                </div>
                            </div>

                            <div style="text-align:left;">
                                <nav aria-label="Footer navigation">
                                    <ul style="list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:10px 18px;justify-content:flex-start;">
                                        <li><a href="/" style="text-decoration:none;color:#2e465f;font-size:16px;font-weight:600;">الرئيسية</a></li>
                                        <li><span style="color:#82aac8;">•</span></li>
                                        <li><a href="/our-works" style="text-decoration:none;color:#2e465f;font-size:16px;font-weight:600;">المشاريع</a></li>
                                        <li><span style="color:#82aac8;">•</span></li>
                                        <li><a href="/contactus" style="text-decoration:none;color:#2e465f;font-size:16px;font-weight:600;">اتصل بنا</a></li>
                                    </ul>
                                </nav>
                            </div>

                        </div>
                    </div>
                </section>
            </div>

        </xpath>
    </template>

</odoo>