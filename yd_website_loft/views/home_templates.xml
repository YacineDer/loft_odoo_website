                    <div class="loft-icon-box" t-att-style="is_ar and 'margin-right:0;margin-bottom:24px;' or 'margin-left:0;margin-bottom:24px;'">
                        <i class="fa fa-lightbulb-o" aria-hidden="true"/>
                    </div>
                    <h3 style="font-size:18px;font-weight:800;color:#2e465f;margin:0 0 10px;">Innovation and Sustainability</h3>
                    <p style="font-size:14px;line-height:1.9;color:#9e9e9e;margin:0;">Providing modern solutions that look to the future and keep pace with market aspirations.</p>
                </div>
            </div>
        </div>
    </section>
</template>

<template id="loft_contact_strip" name="Loft Contact Strip">
    <t t-set="is_ar" t-value="request.env.lang and request.env.lang[:2] == 'ar'"/>
    <section style="padding:80px 0;background:#1f2d3a;" t-att-dir="is_ar and 'rtl' or 'ltr'" t-att-lang="is_ar and 'ar' or 'en'">
        <div style="max-width:1180px;margin:0 auto;padding:0 24px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:24px;">
            <div class="loft-stat-card" style="text-align:center;flex-shrink:0;padding:28px 40px;min-width:260px;">
                <div style="font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#9e9e9e;margin-bottom:8px;">Phone</div>
                <div t-esc="company_phone or '—'" style="font-size:20px;font-weight:700;color:#2e465f;line-height:1.6;"/>
            </div>
            <div class="loft-stat-card" t-att-style="is_ar and 'flex:1;min-width:220px;padding:28px 32px;text-align:right;background:linear-gradient(145deg,#ffffff 0%,#f4f4f4 100%);' or 'flex:1;min-width:220px;padding:28px 32px;text-align:left;background:linear-gradient(145deg,#ffffff 0%,#f4f4f4 100%);'">
                <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#82aac8;margin-bottom:8px;">Email</div>
                <div t-if="company_email" style="font-size:20px;font-weight:700;color:#2e465f;">
                    <a t-att-href="'mailto:%s' % company_email" t-esc="company_email" style="text-decoration:none;color:inherit;"/>
                </div>
                <div t-else="" style="font-size:20px;font-weight:700;color:#2e465f;">—</div>
            </div>
            <div class="loft-stat-card" t-att-style="is_ar and 'flex:1;min-width:260px;padding:28px 32px;text-align:right;background:linear-gradient(145deg,#ffffff 0%,#f4f4f4 100%);' or 'flex:1;min-width:260px;padding:28px 32px;text-align:left;background:linear-gradient(145deg,#ffffff 0%,#f4f4f4 100%);'">
                <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#82aac8;margin-bottom:8px;">Address</div>
                <div t-esc="company_address or '—'" style="font-size:15px;font-weight:600;line-height:1.6;color:#2e465f;"/>
            </div>
        </div>
    </section>
</template>

<template id="page_home" name="Loft Construction — Home">
    <t t-call="website.layout">
        <t t-set="title">Loft Construction — General Contracting &amp; Renovation</t>
        <t t-call="yd_website_loft.loft_assets"/>
        <t t-set="is_ar" t-value="request.env.lang and request.env.lang[:2] == 'ar'"/>
        <div id="wrap" t-att-dir="is_ar and 'rtl' or 'ltr'" t-att-lang="is_ar and 'ar' or 'en'" style="background:#f4f4f4;color:#2e465f;font-family:'Inter','Helvetica Neue',sans-serif;overflow-x:hidden;">

            <section class="loft-hero-lines" style="position:relative;min-height:94vh;display:flex;align-items:center;background:linear-gradient(135deg,#f4f4f4 0%,#eceff2 40%,#dde5eb 100%);overflow:hidden;">
                <div class="loft-hero-grid" style="position:absolute;inset:0;opacity:0.65;"/>
                <div style="position:absolute;top:-80px;left:-80px;width:320px;height:320px;background:radial-gradient(circle,rgba(130,170,200,0.16) 0%,transparent 72%);border-radius:50%;"/>
                <div style="position:absolute;bottom:-120px;right:-40px;width:360px;height:360px;background:radial-gradient(circle,rgba(46,70,95,0.08) 0%,transparent 75%);border-radius:50%;"/>
                <div style="position:relative;z-index:1;max-width:1180px;margin:0 auto;padding:0 24px;width:100%;">
                    <div t-att-style="is_ar and 'max-width:700px;text-align:right;' or 'max-width:700px;text-align:left;'">
                        <t t-call="yd_website_loft.loft_eyebrow">
                            <t t-set="text">LOFT FOR BUILDING CONSTRUCTION</t>
                        </t>
                        <h1 class="loft-hero-title" style="font-size:68px;font-weight:800;line-height:1.02;letter-spacing:-2px;margin:0 0 26px;color:#2e465f;text-transform:uppercase;max-width:760px;">
                            LOFT <br/>Construction
                        </h1>
                        <p style="font-size:17px;line-height:1.9;color:#6f7c88;max-width:560px;margin:0 0 40px;">
                            Loft General Contracting is a company specialized in the construction sector and has been operating in Kuwait since 2019. Since its establishment, the company has aimed to be a trusted partner in delivering modern architectural projects.
                        </p>
                    </div>
                </div>
                <div style="position:absolute;bottom:0;left:0;right:0;transform:translateY(-10%);z-index:4;">
                  <div style="max-width:1180px;margin:0 auto;padding:0 24px;display:flex;justify-content:center;">
                    <div class="loft-stats-grid" style="display:grid;grid-template-columns:repeat(2,minmax(320px, 1fr));gap:24px;align-items:stretch;width:min(100%, 900px);">
                      <div class="loft-stat-card" style="padding:34px 28px 30px;text-align:center;">
                        <div class="loft-stat-number">Quality and Professionalism</div>
                      </div>
                      <div class="loft-stat-card" style="padding:34px 28px 30px;text-align:center;">
                        <div class="loft-stat-number">Integrity and Commitment</div>
                      </div>
                    </div>
                  </div>
                </div>
            </section>

            <section style="padding:250px 0 120px;background:#f4f4f4;">
                <div class="loft-about-grid" style="max-width:1180px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:0.42fr 1.58fr;gap:64px;align-items:center;">
                    <div class="loft-card3d" style="display:flex;align-items:center;justify-content:center;padding:32px;aspect-ratio:1/1;background:#ffffff;">
                        <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;">
                            <img src="/logo.png" alt="Loft Construction Logo"
                                 style="max-width:75%;max-height:75%;width:auto;height:auto;object-fit:contain;display:block;"/>
                        </div>
                    </div>
                    <div t-att-dir="is_ar and 'rtl' or 'ltr'" t-att-lang="is_ar and 'ar' or 'en'" t-att-style="is_ar and 'text-align:right;' or 'text-align:left;'">
                        <t t-call="yd_website_loft.loft_eyebrow">
                            <t t-set="text">About Us</t>
                        </t>
                        <h2 style="font-size:32px;font-weight:800;color:#2e465f;line-height:1.5;margin:0 0 22px;">
                            Loft General Contracting Company
                        </h2>
                        <p style="font-size:16px;line-height:2;color:#9e9e9e;margin:0 0 16px;">
                            Loft General Contracting is a company specialized in the construction sector and has been operating in Kuwait since 2019. Since its establishment, the company has aimed to be a trusted partner in delivering modern architectural projects.
                        </p>
                        <p style="font-size:16px;line-height:2;color:#9e9e9e;margin:0;">
                            From the beginning, the company has focused on balancing high quality with meeting deadlines by providing integrated solutions that meet the needs of the construction market. The company relies on a specialized team and a professional execution methodology to ensure projects are completed efficiently and with high quality, meeting client expectations and keeping pace with urban development in Kuwait.
                        </p>
                    </div>
                </div>
            </section>

            <t t-call="yd_website_loft.loft_vision_mission"/>
            <t t-call="yd_website_loft.loft_values"/>

            <section style="padding:130px 0;background:#ffffff;">
                <div style="max-width:1180px;margin:0 auto;padding:0 24px;" t-att-dir="is_ar and 'rtl' or 'ltr'" t-att-lang="is_ar and 'ar' or 'en'">
                    <div t-att-style="is_ar and 'text-align:right;margin-bottom:56px;' or 'text-align:left;margin-bottom:56px;'">
                        <t t-call="yd_website_loft.loft_eyebrow">
                            <t t-set="text">Our Services</t>
                        </t>
                        <h2 style="font-size:40px;font-weight:800;color:#2e465f;margin:0;max-width:620px;line-height:1.3;">
                            Loft Construction offers a comprehensive range of services in the construction sector
                        </h2>
                    </div>

                    <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;align-items:stretch;">
                        <div class="loft-card3d" t-att-style="is_ar and 'padding:44px 32px;text-align:right;' or 'padding:44px 32px;text-align:left;'">
                            <div class="loft-icon-box" t-att-style="is_ar and 'margin-right:0;margin-bottom:26px;' or 'margin-left:0;margin-bottom:26px;'">
                                <i class="fa fa-home" aria-hidden="true"/>
                            </div>
                            <h3 style="font-size:19px;font-weight:800;color:#2e465f;margin:0 0 12px;">Residential Construction Projects</h3>
                            <p style="font-size:14px;line-height:1.9;color:#9e9e9e;margin:0;">Executing residential construction projects through all phases, according to the highest quality standards.</p>
                        </div>

                        <div class="loft-card3d" t-att-style="is_ar and 'padding:44px 32px;text-align:right;' or 'padding:44px 32px;text-align:left;'">
                            <div class="loft-icon-box" t-att-style="is_ar and 'margin-right:0;margin-bottom:26px;' or 'margin-left:0;margin-bottom:26px;'">
                                <i class="fa fa-wrench" aria-hidden="true"/>
                            </div>
                            <h3 style="font-size:19px;font-weight:800;color:#2e465f;margin:0 0 12px;">Renovation and Maintenance Works</h3>
                            <p style="font-size:14px;line-height:1.9;color:#9e9e9e;margin:0;">Rehabilitating buildings and providing sustainable maintenance solutions.</p>
                        </div>

                        <div class="loft-card3d" t-att-style="is_ar and 'padding:44px 32px;text-align:right;' or 'padding:44px 32px;text-align:left;'">
                            <div class="loft-icon-box" t-att-style="is_ar and 'margin-right:0;margin-bottom:26px;' or 'margin-left:0;margin-bottom:26px;'">
                                <i class="fa fa-building" aria-hidden="true"/>
                            </div>
                            <h3 style="font-size:19px;font-weight:800;color:#2e465f;margin:0 0 12px;">Concrete Structural Works</h3>
                            <p style="font-size:14px;line-height:1.9;color:#9e9e9e;margin:0;">Executing concrete structural works with high precision and in accordance with approved technical specifications.</p>
                        </div>

                        <div class="loft-card3d" t-att-style="is_ar and 'padding:44px 32px;text-align:right;' or 'padding:44px 32px;text-align:left;'">
                            <div class="loft-icon-box" t-att-style="is_ar and 'margin-right:0;margin-bottom:26px;' or 'margin-left:0;margin-bottom:26px;'">
                                <i class="fa fa-paint-brush" aria-hidden="true"/>
                            </div>
                            <h3 style="font-size:19px;font-weight:800;color:#2e465f;margin:0 0 12px;">Complete Finishing Works</h3>
                            <p style="font-size:14px;line-height:1.9;color:#9e9e9e;margin:0;">Executing complete finishing works according to approved specifications and with high quality.</p>
                        </div>

                        <div style="grid-column:1 / -1;display:flex;justify-content:center;">
                            <div class="loft-card3d" style="padding:44px 32px;text-align:left;width:100%;max-width:calc(50% - 12px);">
                                <div class="loft-icon-box" style="margin-left:0;margin-bottom:26px;">
                                    <i class="fa fa-cogs" aria-hidden="true"/>
                                </div>
                                <h3 style="font-size:19px;font-weight:800;color:#2e465f;margin:0 0 12px;">Project Management and Engineering Supervision</h3>
                                <p style="font-size:14px;line-height:1.9;color:#9e9e9e;margin:0;">Managing projects and providing engineering supervision through a clear professional methodology that ensures execution quality.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section style="padding:100px 0;background:#f4f4f4;" t-att-dir="is_ar and 'rtl' or 'ltr'" t-att-lang="is_ar and 'ar' or 'en'">
                <div style="max-width:1180px;margin:0 auto;padding:0 24px;">
                    <div t-att-style="is_ar and 'text-align:right;margin-bottom:46px;' or 'text-align:left;margin-bottom:46px;'">
                        <t t-call="yd_website_loft.loft_eyebrow">
                            <t t-set="text">Selected Works</t>
                        </t>
                        <h2 style="font-size:36px;font-weight:800;color:#2e465f;line-height:1.35;margin:0;">
                            Latest Completed Projects
                        </h2>
                    </div>

                    <div class="loft-grid-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;">
                        <t t-foreach="projects" t-as="project">
                            <div class="loft-card3d o_loft_project_card">
                                <div class="o_loft_project_gallery">
                                    <t t-if="project.image_ids">
                                        <t t-foreach="project.image_ids" t-as="img">
                                            <img t-att-src="'/web/image/loft.project.image/%s/image' % img.id"
                                                 t-att-alt="project.name"
                                                 t-attf-class="o_loft_gallery_img #{img_index == 0 and 'active' or ''}"/>
                                        </t>
                                    </t>
                                    <div t-else="" class="o_loft_no_image"/>

                                    <div t-if="len(project.image_ids) > 1" class="o_loft_gallery_dots">
                                        <t t-foreach="project.image_ids" t-as="img">
                                            <span t-attf-class="o_loft_dot #{img_index == 0 and 'active' or ''}"/>
                                        </t>
                                    </div>

                                    <span t-if="project.area_sqm" class="o_loft_area_badge">
                                        <t t-esc="int(project.area_sqm)"/> m²
                                    </span>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </section>

            <t t-call="yd_website_loft.loft_cta_banner"/>
            <t t-call="yd_website_loft.loft_contact_strip"/>

        </div>
    </t>
</template>

</odoo>