                    <div class="loft-icon-box" t-att-style="is_ar and 'margin-right:0;margin-bottom:24px;' or 'margin-left:0;margin-bottom:24px;'">
                        <i class="fa fa-handshake-o" aria-hidden="true"/>
                    </div>
                    <h3 style="font-size:18px;font-weight:800;color:#2e465f;margin:0 0 10px;">Integrity and Commitment</h3>
