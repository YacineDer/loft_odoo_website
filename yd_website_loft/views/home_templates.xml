<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="loft_eyebrow" name="Loft Eyebrow">
    <div style="display:flex;align-items:center;gap:14px;margin-bottom:18px;">
        <span style="width:38px;height:2px;background:#c7a97a;display:inline-block;"/>
        <span style="font-size:13px;letter-spacing:3px;text-transform:uppercase;color:#a78657;font-weight:700;">
            <t t-esc="text"/>
        </span>
    </div>
</template>

<template id="loft_cta_banner" name="Loft CTA Banner">
    <section style="position:relative;padding:100px 0;background:#f3eee6;border-top:1px solid rgba(199,169,122,0.28);">
        <div style="max-width:1180px;margin:0 auto;padding:0 24px;display:flex;align-items:center;justify-content:space-between;gap:40px;flex-wrap:wrap;">
            <div style="max-width:640px;">
                <t t-call="yd_website_loft.loft_eyebrow">
                    <t t-set="text">GET STARTED</t>
                </t>
                <h2 style="font-size:40px;font-weight:800;color:#1f1a17;margin:0 0 16px;letter-spacing:-0.5px;line-height:1.15;">
                    <t t-esc="cta_title or 'Have blueprints? Let&#8217;s build them.'"/>
                </h2>
                <p style="font-size:16px;line-height:1.7;color:rgba(31,26,23,0.68);margin:0;">
                    <t t-esc="cta_text or 'Tell us about your site and we will come back with a scope, a schedule and a real number.'"/>
                </p>
            </div>
            <div style="text-align:center;flex-shrink:0;">
                <div style="font-size:12px;letter-spacing:2px;text-transform:uppercase;color:rgba(31,26,23,0.45);margin-bottom:8px;">Call us</div>
                <div style="font-size:28px;font-weight:800;color:#a78657;letter-spacing:0.5px;">+965 XXXX XXXX</div>
            </div>
        </div>
    </section>
</template>

<template id="loft_process" name="Loft Process">
    <section style="position:relative;padding:120px 0;background:#f7f4ee;">
        <div style="max-width:1180px;margin:0 auto;padding:0 24px;">
            <div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:24px;margin-bottom:64px;">
                <div>
                    <t t-call="yd_website_loft.loft_eyebrow">
                        <t t-set="text">HOW WE BUILD</t>
                    </t>
                    <h2 style="font-size:44px;font-weight:800;color:#1f1a17;letter-spacing:-1px;margin:0;max-width:520px;line-height:1.15;">From site survey to handover, in four stages</h2>
                </div>
            </div>
            <div style="display:grid;grid-template-columns:repeat(4,1fr);">
                <div style="padding:0 28px 0 0;border-left:1px solid rgba(199,169,122,0.28);padding-left:28px;">
                    <div style="font-size:56px;font-weight:800;color:transparent;-webkit-text-stroke:1.5px rgba(167,134,87,0.45);line-height:1;margin-bottom:20px;">01</div>
                    <h3 style="font-size:19px;font-weight:700;color:#1f1a17;margin:0 0 12px;text-transform:uppercase;letter-spacing:0.5px;">Consultation &amp; Survey</h3>
                    <p style="font-size:14px;line-height:1.7;color:rgba(31,26,23,0.62);margin:0;">We walk the site, take real measurements and understand the brief and the budget before anything is drawn.</p>
                </div>
                <div style="padding-left:28px;border-left:1px solid rgba(199,169,122,0.28);">
                    <div style="font-size:56px;font-weight:800;color:transparent;-webkit-text-stroke:1.5px rgba(167,134,87,0.45);line-height:1;margin-bottom:20px;">02</div>
                    <h3 style="font-size:19px;font-weight:700;color:#1f1a17;margin:0 0 12px;text-transform:uppercase;letter-spacing:0.5px;">Design &amp; Permits</h3>
                    <p style="font-size:14px;line-height:1.7;color:rgba(31,26,23,0.62);margin:0;">Structural drawings, engineering sign-off and permit filing, handled so nothing stalls once crews mobilise.</p>
                </div>
                <div style="padding-left:28px;border-left:1px solid rgba(199,169,122,0.28);">
                    <div style="font-size:56px;font-weight:800;color:transparent;-webkit-text-stroke:1.5px rgba(167,134,87,0.45);line-height:1;margin-bottom:20px;">03</div>
                    <h3 style="font-size:19px;font-weight:700;color:#1f1a17;margin:0 0 12px;text-transform:uppercase;letter-spacing:0.5px;">Build</h3>
                    <p style="font-size:14px;line-height:1.7;color:rgba(31,26,23,0.62);margin:0;">Our own crews and vetted trades execute against a fixed schedule, with weekly site reports back to you.</p>
                </div>
                <div style="padding-left:28px;border-left:1px solid rgba(199,169,122,0.28);">
                    <div style="font-size:56px;font-weight:800;color:transparent;-webkit-text-stroke:1.5px rgba(167,134,87,0.45);line-height:1;margin-bottom:20px;">04</div>
                    <h3 style="font-size:19px;font-weight:700;color:#1f1a17;margin:0 0 12px;text-transform:uppercase;letter-spacing:0.5px;">Handover</h3>
                    <p style="font-size:14px;line-height:1.7;color:rgba(31,26,23,0.62);margin:0;">Snagging, as-built documentation and warranty pack delivered before you get the keys.</p>
                </div>
            </div>
        </div>
    </section>
</template>

<template id="page_home" name="Loft Construction — Home">
    <t t-call="website.layout">
        <t t-set="title">Loft Construction — General Contracting &amp; Renovation</t>
        <div id="wrap" style="background:#f7f4ee;color:#1f1a17;font-family:'Inter','Helvetica Neue',sans-serif;overflow-x:hidden;">

            <section style="position:relative;min-height:92vh;display:flex;align-items:center;">
                <div style="position:absolute;inset:0;z-index:0;">
                    <img src="/yd_website_loft/static/src/images/loft2.jpg" alt="Loft Construction"
                         style="width:100%;height:100%;object-fit:cover;display:block;"/>
                    <div style="position:absolute;inset:0;background:linear-gradient(90deg, rgba(247,244,238,0.94) 0%, rgba(247,244,238,0.74) 42%, rgba(247,244,238,0.18) 100%);"/>
                </div>
                <div style="position:relative;z-index:1;max-width:1180px;margin:0 auto;padding:0 24px;width:100%;">
                    <div style="max-width:640px;">
                        <t t-call="yd_website_loft.loft_eyebrow">
                            <t t-set="text">GENERAL CONTRACTING · EST. 2019</t>
                        </t>
                        <h1 style="font-size:64px;font-weight:800;line-height:1.02;letter-spacing:-2px;margin:0 0 26px;color:#1f1a17;text-transform:uppercase;">
                            We Build<br/>What You<br/>
                            <span style="color:#a78657;">Approved.</span>
                        </h1>
                        <p style="font-size:17px;line-height:1.7;color:rgba(31,26,23,0.78);max-width:460px;margin:0 0 40px;">
                            Loft Construction delivers residential, commercial and industrial projects on a fixed scope, a fixed schedule and a number that doesn't move once the contract is signed.
                        </p>
                    </div>
                </div>
                <div style="position:absolute;bottom:0;left:0;right:0;transform:translateY(50%);z-index:2;">
                    <div style="max-width:1180px;margin:0 auto;padding:0 24px;">
                        <div style="background:#ffffff;border:1px solid rgba(199,169,122,0.3);display:grid;grid-template-columns:repeat(3,1fr);box-shadow:0 18px 50px rgba(31,26,23,0.08);">
                            <div style="padding:32px 24px;text-align:center;border-right:1px solid rgba(199,169,122,0.18);">
                                <div style="font-size:34px;font-weight:800;color:#a78657;line-height:1;">6</div>
                                <div style="font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:rgba(31,26,23,0.5);margin-top:8px;">Years On Site</div>
                            </div>
                            <div style="padding:32px 24px;text-align:center;border-right:1px solid rgba(199,169,122,0.18);">
                                <div style="font-size:34px;font-weight:800;color:#a78657;line-height:1;">40+</div>
                                <div style="font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:rgba(31,26,23,0.5);margin-top:8px;">Projects Delivered</div>
                            </div>
                            <div style="padding:32px 24px;text-align:center;border-right:1px solid rgba(199,169,122,0.18);">
                                <div style="font-size:34px;font-weight:800;color:#a78657;line-height:1;">20+</div>
                                <div style="font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:rgba(31,26,23,0.5);margin-top:8px;">Specialists</div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section style="padding:180px 0 110px;background:#f7f4ee;">
                <div style="max-width:1180px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:0.4fr 1.6fr;gap:64px;align-items:center;">
                    <div style="display:flex;align-items:center;justify-content:center;background:#ffffff;border:1px solid rgba(199,169,122,0.24);padding:36px;aspect-ratio:1/1;box-shadow:0 12px 34px rgba(31,26,23,0.06);">
                       <img src="/logo.png" alt="Loft Construction Logo" style="max-width:100%;max-height:100%;object-fit:contain;filter:grayscale(1) invert(1) brightness(1.15);"/>
                    </div>
                    <div dir="rtl" lang="ar" style="text-align:right;">
                        <t t-call="yd_website_loft.loft_eyebrow">
                            <t t-set="text">من نحن</t>
                        </t>
                        <h2 style="font-size:32px;font-weight:800;color:#1f1a17;line-height:1.5;margin:0 0 22px;">
                            شركة لوفت للتشييد
                        </h2>
                        <p style="font-size:16px;line-height:2;color:rgba(31,26,23,0.72);margin:0 0 16px;">
                            شركة لوفت للتشييد المباني تعمل منذ 2019 في الكويت، لتكون شريكًا موثوقًا في تنفيذ المشاريع العمرانية الحديثة.
                        </p>
                        <p style="font-size:16px;line-height:2;color:rgba(31,26,23,0.72);margin:0;">
                            منذ انطلاقتها، وضعت الشركة نصب أعينها الجمع بين الجودة العالية والالتزام بالمواعيد، لتقديم حلول متكاملة في مجال البناء والتشييد.
                        </p>
                    </div>
                </div>
            </section>

            <section style="padding:110px 0;background:#f3eee6;">
                <div style="max-width:1180px;margin:0 auto;padding:0 24px;" dir="rtl" lang="ar">
                    <div style="text-align:right;margin-bottom:56px;">
                        <t t-call="yd_website_loft.loft_eyebrow">
                            <t t-set="text">خدماتنا</t>
                        </t>
                        <h2 style="font-size:40px;font-weight:800;color:#1f1a17;margin:0;max-width:560px;margin-right:0;margin-left:auto;line-height:1.3;">كل ما يحتاجه مشروعك تحت عقد واحد</h2>
                    </div>
                    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(199,169,122,0.22);">
                        <div style="background:#ffffff;padding:44px 32px;text-align:right;">
                            <div style="width:50px;height:50px;border:1.5px solid #c7a97a;display:flex;align-items:center;justify-content:center;color:#a78657;font-size:20px;margin-bottom:26px;margin-right:0;">
                                <i class="fa fa-paint-roller" aria-hidden="true"/>
                            </div>
                            <h3 style="font-size:20px;font-weight:800;color:#1f1a17;margin:0 0 12px;">أعمال التشطيب الشاملة</h3>
                            <p style="font-size:14px;line-height:1.9;color:rgba(31,26,23,0.62);margin:0;">تشطيبات داخلية وخارجية متكاملة بأعلى معايير الجودة والدقة.</p>
                        </div>
                        <div style="background:#ffffff;padding:44px 32px;text-align:right;">
                            <div style="width:50px;height:50px;border:1.5px solid #c7a97a;display:flex;align-items:center;justify-content:center;color:#a78657;font-size:20px;margin-bottom:26px;margin-right:0;">
                                <i class="fa fa-building" aria-hidden="true"/>
                            </div>
                            <h3 style="font-size:20px;font-weight:800;color:#1f1a17;margin:0 0 12px;">أعمال الهيكل الإنشائي</h3>
                            <p style="font-size:14px;line-height:1.9;color:rgba(31,26,23,0.62);margin:0;">تنفيذ الهياكل الخرسانية والإنشائية وفق أعلى معايير السلامة.</p>
                        </div>
                        <div style="background:#ffffff;padding:44px 32px;text-align:right;">
                            <div style="width:50px;height:50px;border:1.5px solid #c7a97a;display:flex;align-items:center;justify-content:center;color:#a78657;font-size:20px;margin-bottom:26px;margin-right:0;">
                                <i class="fa fa-tools" aria-hidden="true"/>
                            </div>
                            <h3 style="font-size:20px;font-weight:800;color:#1f1a17;margin:0 0 12px;">أعمال الصيانة والترميم</h3>
                            <p style="font-size:14px;line-height:1.9;color:rgba(31,26,23,0.62);margin:0;">خدمات صيانة وترميم شاملة تحافظ على جودة المبنى مع مرور الزمن.</p>
                        </div>
                    </div>
                </div>
            </section>

            <t t-call="yd_website_loft.loft_process"/>

            <section style="padding:120px 0;background:#f3eee6;">
                <div style="max-width:1180px;margin:0 auto;padding:0 24px;">
                    <t t-call="yd_website_loft.loft_eyebrow">
                        <t t-set="text">SELECTED WORK</t>
                    </t>
                    <h2 style="font-size:44px;font-weight:800;color:#1f1a17;letter-spacing:-1px;margin:0 0 56px;">Recently completed</h2>
                    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:2px;background:rgba(199,169,122,0.16);">
                        <t t-foreach="featured_projects" t-as="project">
                            <div style="background:#ffffff;">
                                <div style="position:relative;aspect-ratio:4/3;overflow:hidden;">
                                    <img t-if="project.image" t-att-src="'/web/image/loft.project/%s/image' % project.id"
                                         t-att-alt="project.name" style="width:100%;height:100%;object-fit:cover;display:block;"/>
                                    <div t-else="" style="width:100%;height:100%;background:#efe8da;"/>
                                    <span t-if="project.area_sqm" style="position:absolute;top:14px;left:14px;font-size:11px;color:#ffffff;background:#a78657;padding:4px 10px;font-weight:700;">
                                        <t t-esc="int(project.area_sqm)"/> M&#178;
                                    </span>
                                </div>
                                <div style="padding:26px 20px 28px;">
                                    <span style="font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:#a78657;font-weight:700;" t-esc="project.category_id.name"/>
                                    <h3 style="font-size:18px;font-weight:700;color:#1f1a17;margin:12px 0 8px;" t-esc="project.name"/>
                                    <p style="font-size:14px;line-height:1.6;color:rgba(31,26,23,0.62);margin:0;" t-esc="project.short_description"/>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </section>

            <t t-call="yd_website_loft.loft_cta_banner"/>
        </div>
    </t>
</template>

</odoo>