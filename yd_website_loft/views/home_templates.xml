<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="loft_assets" name="Loft Assets">
    <style>
        .loft-card3d {
            background: linear-gradient(145deg, #ffffff 0%, #f4f4f4 100%);
            border: 1px solid rgba(158,158,158,0.18);
            border-radius: 18px;
            box-shadow: 0 2px 6px rgba(46,70,95,0.04), 0 16px 34px rgba(46,70,95,0.07), inset 0 1px 0 rgba(255,255,255,0.9);
            transition: transform 0.35s cubic-bezier(0.2,0.8,0.2,1), box-shadow 0.35s cubic-bezier(0.2,0.8,0.2,1);
            transform-style: preserve-3d;
            position: relative;
            overflow: hidden;
            backdrop-filter: blur(4px);
        }
        .loft-card3d:hover {
            transform: translateY(-8px) rotateX(2deg) rotateY(-2deg);
            box-shadow: 0 8px 16px rgba(46,70,95,0.08), 0 26px 56px rgba(46,70,95,0.12), inset 0 1px 0 rgba(255,255,255,0.95);
        }
        .loft-card3d::before {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0; height: 3px;
            background: linear-gradient(90deg, #82aac8, #2e465f);
            opacity: 0;
            transition: opacity 0.35s ease;
        }
        .loft-card3d:hover::before { opacity: 1; }
        .loft-icon-box {
            width: 58px; height: 58px;
            border-radius: 16px;
            background: linear-gradient(145deg, #2e465f 0%, #3d5874 100%);
            display: flex; align-items: center; justify-content: center;
            color: #e4e4e4; font-size: 20px;
            box-shadow: 0 10px 24px rgba(46,70,95,0.20), inset 0 1px 0 rgba(255,255,255,0.08);
        }
        .loft-hero-grid {
            background-image:
                linear-gradient(rgba(158,158,158,0.10) 1px, transparent 1px),
                linear-gradient(90deg, rgba(158,158,158,0.10) 1px, transparent 1px);
            background-size: 42px 42px;
        }
        .loft-hero-lines::before,
        .loft-hero-lines::after {
            content: "";
            position: absolute;
            inset: auto;
            border: 1px solid rgba(130,170,200,0.18);
            border-radius: 24px;
            transform: rotate(-8deg);
        }
        .loft-hero-lines::before {
            width: 420px; height: 420px; top: 60px; right: 8%;
        }
        .loft-hero-lines::after {
            width: 300px; height: 300px; bottom: 80px; right: 18%;
            transform: rotate(12deg);
        }
        .loft-stat-card {
            background: linear-gradient(145deg, #ffffff 0%, #f1f3f5 100%);
            border: 1px solid rgba(158,158,158,0.18);
            border-radius: 18px;
            box-shadow: 0 2px 6px rgba(46,70,95,0.04), 0 16px 34px rgba(46,70,95,0.08), inset 0 1px 0 rgba(255,255,255,0.92);
            transition: transform 0.35s cubic-bezier(0.2,0.8,0.2,1), box-shadow 0.35s cubic-bezier(0.2,0.8,0.2,1);
            transform-style: preserve-3d;
            position: relative;
            overflow: hidden;
        }
        .loft-stat-card:hover {
            transform: translateY(-8px) rotateX(2deg) rotateY(-2deg);
            box-shadow: 0 8px 16px rgba(46,70,95,0.08), 0 26px 56px rgba(46,70,95,0.14), inset 0 1px 0 rgba(255,255,255,0.96);
        }
        .loft-stat-card::before {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0; height: 3px;
            background: linear-gradient(90deg, #82aac8, #2e465f);
            opacity: 0;
            transition: opacity 0.35s ease;
        }
        .loft-stat-card:hover::before { opacity: 1; }
        .loft-stat-number {
            font-size: 38px;
            font-weight: 800;
            color: #2e465f;
            line-height: 1;
            letter-spacing: -1px;
            margin-bottom: 10px;
        }
        .loft-stat-label {
            font-size: 12px;
            letter-spacing: 1.8px;
            text-transform: uppercase;
            color: #9e9e9e;
        }
        @media (max-width: 992px) {
            .loft-grid-4, .loft-grid-3, .loft-grid-2 { grid-template-columns: repeat(2,1fr) !important; }
        }
        @media (max-width: 768px) {
            .loft-grid-4, .loft-grid-3, .loft-grid-2 { grid-template-columns: 1fr !important; }
            .loft-about-grid { grid-template-columns: 1fr !important; }
            .loft-stats-grid { grid-template-columns: 1fr !important; }
            .loft-hero-title { font-size: 44px !important; }
            .loft-hero-lines::before, .loft-hero-lines::after { display:none; }
        }
    </style>
</template>

<template id="loft_eyebrow" name="Loft Eyebrow">
    <div style="display:flex;align-items:center;gap:14px;margin-bottom:18px;">
        <span style="width:42px;height:3px;background:linear-gradient(90deg,#82aac8,#2e465f);display:inline-block;border-radius:2px;"/>
        <span style="font-size:13px;letter-spacing:3px;text-transform:uppercase;color:#2e465f;font-weight:700;">
            <t t-esc="text"/>
        </span>
    </div>
</template>

<template id="loft_cta_banner" name="Loft CTA Banner">
    <section style="position:relative;padding:110px 0;background:#1f2d3a;overflow:hidden;">
        <div class="loft-hero-grid" style="position:absolute;inset:0;opacity:0.45;"/>
        <div style="position:absolute;top:-140px;right:-80px;width:380px;height:380px;background:radial-gradient(circle,rgba(130,170,200,0.16) 0%,transparent 72%);border-radius:50%;"/>
        <div style="position:relative;max-width:1180px;margin:0 auto;padding:0 24px;display:flex;align-items:center;justify-content:space-between;gap:40px;flex-wrap:wrap;">
            <div style="max-width:640px;">
                <div style="display:flex;align-items:center;gap:14px;margin-bottom:18px;">
                    <span style="width:42px;height:3px;background:linear-gradient(90deg,#82aac8,#e4e4e4);display:inline-block;border-radius:2px;"/>
                    <span style="font-size:13px;letter-spacing:3px;text-transform:uppercase;color:#82aac8;font-weight:700;">تواصل معنا</span>
                </div>
                <h2 style="font-size:40px;font-weight:800;color:#ffffff;margin:0 0 16px;letter-spacing:-0.5px;line-height:1.15;">ابدأ مشروعك مع لوفت</h2>
                <p style="font-size:16px;line-height:1.9;color:rgba(228,228,228,0.76);margin:0;max-width:620px;">نقدّم لك حلولاً متكاملة في قطاع البناء والتشييد، مع التزام واضح بالجودة، الدقة، والجدول الزمني في جميع مراحل التنفيذ.</p>
            </div>
            <div class="loft-stat-card" style="text-align:center;flex-shrink:0;padding:28px 40px;min-width:260px;">
                <div style="font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#9e9e9e;margin-bottom:8px;">الهاتف</div>
                <div t-if="website.company_id.phone"
                     t-esc="website.company_id.phone"
                     style="font-size:28px;font-weight:800;color:#82aac8;letter-spacing:0.5px;"/>
                <div t-else=""
                     style="font-size:28px;font-weight:800;color:#82aac8;letter-spacing:0.5px;">
                    —
                </div>
            </div>
        </div>
    </section>
</template>

<template id="loft_process" name="Loft Process">
    <section style="position:relative;padding:130px 0;background:#f4f4f4;">
        <div style="max-width:1180px;margin:0 auto;padding:0 24px;">
            <div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:24px;margin-bottom:64px;">
                <div>
                    <t t-call="yd_website_loft.loft_eyebrow">
                        <t t-set="text">آلية العمل</t>
                    </t>
                    <h2 style="font-size:44px;font-weight:800;color:#2e465f;letter-spacing:-1px;margin:0;max-width:520px;line-height:1.15;">من المعاينة الميدانية إلى التسليم النهائي، عبر أربع مراحل واضحة</h2>
                </div>
            </div>
            <div class="loft-grid-4" style="display:grid;grid-template-columns:repeat(4,1fr);gap:24px;">
                <div class="loft-card3d" style="padding:36px 28px;">
                    <div style="font-size:52px;font-weight:800;color:transparent;-webkit-text-stroke:1.5px #82aac8;line-height:1;margin-bottom:20px;">01</div>
                    <h3 style="font-size:18px;font-weight:700;color:#2e465f;margin:0 0 12px;text-transform:uppercase;letter-spacing:0.5px;">الاستشارة والمعاينة</h3>
                    <p style="font-size:14px;line-height:1.7;color:#9e9e9e;margin:0;">نقوم بزيارة الموقع، وأخذ القياسات الفعلية، وفهم متطلبات المشروع والميزانية قبل البدء بأي أعمال تصميم أو تنفيذ.</p>
                </div>
                <div class="loft-card3d" style="padding:36px 28px;">
                    <div style="font-size:52px;font-weight:800;color:transparent;-webkit-text-stroke:1.5px #82aac8;line-height:1;margin-bottom:20px;">02</div>
                    <h3 style="font-size:18px;font-weight:700;color:#2e465f;margin:0 0 12px;text-transform:uppercase;letter-spacing:0.5px;">التصميم والتصاريح</h3>
                    <p style="font-size:14px;line-height:1.7;color:#9e9e9e;margin:0;">نعمل على إعداد المخططات الهندسية والاعتمادات الفنية واستكمال إجراءات التصاريح بما يضمن انطلاق التنفيذ دون تأخير.</p>
                </div>
                <div class="loft-card3d" style="padding:36px 28px;">
                    <div style="font-size:52px;font-weight:800;color:transparent;-webkit-text-stroke:1.5px #82aac8;line-height:1;margin-bottom:20px;">03</div>
                    <h3 style="font-size:18px;font-weight:700;color:#2e465f;margin:0 0 12px;text-transform:uppercase;letter-spacing:0.5px;">التنفيذ</h3>
                    <p style="font-size:14px;line-height:1.7;color:#9e9e9e;margin:0;">تتولى فرقنا التنفيذ وفق جدول زمني واضح، مع متابعة مستمرة وتقارير دورية تضمن جودة الإنجاز في كل مرحلة.</p>
                </div>
                <div class="loft-card3d" style="padding:36px 28px;">
                    <div style="font-size:52px;font-weight:800;color:transparent;-webkit-text-stroke:1.5px #82aac8;line-height:1;margin-bottom:20px;">04</div>
                    <h3 style="font-size:18px;font-weight:700;color:#2e465f;margin:0 0 12px;text-transform:uppercase;letter-spacing:0.5px;">التسليم</h3>
                    <p style="font-size:14px;line-height:1.7;color:#9e9e9e;margin:0;">ننجز أعمال المراجعة النهائية، وتسليم المستندات اللازمة، وضمان جاهزية المشروع قبل التسليم الكامل للعميل.</p>
                </div>
            </div>
        </div>
    </section>
</template>

<template id="loft_vision_mission" name="Loft Vision and Mission">
    <section style="padding:130px 0;background:#ffffff;" dir="rtl" lang="ar">
        <div style="max-width:1180px;margin:0 auto;padding:0 24px;">
            <div style="text-align:right;margin-bottom:56px;">
                <t t-call="yd_website_loft.loft_eyebrow">
                    <t t-set="text">رؤيتنا ورسالتنا</t>
                </t>
            </div>
            <div class="loft-grid-2" style="display:grid;grid-template-columns:repeat(2,1fr);gap:24px;">
                <div class="loft-card3d" style="padding:48px 40px;text-align:right;">
                    <div class="loft-icon-box" style="margin-right:0;margin-bottom:24px;">
                        <i class="fa fa-eye" aria-hidden="true"/>
                    </div>
                    <h3 style="font-size:22px;font-weight:800;color:#2e465f;margin:0 0 16px;">الرؤية</h3>
                    <p style="font-size:15px;line-height:2;color:#9e9e9e;margin:0;">قيادة مستقبل قطاع البناء في الكويت من خلال دمج التكنولوجيا المتقدمة والحلول الهندسية المبتكرة لبناء مجتمعات عمرانية ذكية ومستدامة تُلهم الأجيال.</p>
                </div>
                <div class="loft-card3d" style="padding:48px 40px;text-align:right;">
                    <div class="loft-icon-box" style="margin-right:0;margin-bottom:24px;">
                        <i class="fa fa-compass" aria-hidden="true"/>
                    </div>
                    <h3 style="font-size:22px;font-weight:800;color:#2e465f;margin:0 0 16px;">الرسالة</h3>
                    <p style="font-size:15px;line-height:2;color:#9e9e9e;margin:0;">تسليم مشاريع إنشائية رائدة باستخدام أحدث الأدوات الرقمية وتقنيات الهندسة لضمان أقصى كفاءة في التنفيذ وجودة فائقة في المنتج النهائي، مع الحفاظ على قيمة مضافة لشركائنا والمجتمع.</p>
                </div>
            </div>
        </div>
    </section>
</template>

<template id="loft_values" name="Loft Values">
    <section style="padding:130px 0;background:#f4f4f4;" dir="rtl" lang="ar">
        <div style="max-width:1180px;margin:0 auto;padding:0 24px;">
            <div style="text-align:right;margin-bottom:56px;">
                <t t-call="yd_website_loft.loft_eyebrow">
                    <t t-set="text">قيمنا</t>
                </t>
                <h2 style="font-size:36px;font-weight:800;color:#2e465f;margin:0;max-width:640px;margin-right:0;margin-left:auto;line-height:1.4;">تسترشد شركة لوفت للمقاولات العامة بمجموعة من القيم الأساسية التي تشكّل أساس عملها ونموها المستمر.</h2>
            </div>
            <div class="loft-grid-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;">
                <div class="loft-card3d" style="padding:44px 32px;text-align:right;">
                    <div class="loft-icon-box" style="margin-right:0;margin-bottom:24px;">
                        <i class="fa fa-certificate" aria-hidden="true"/>
                    </div>
                    <h3 style="font-size:18px;font-weight:800;color:#2e465f;margin:0 0 10px;">الجودة والاحترافية</h3>
                    <p style="font-size:14px;line-height:1.9;color:#9e9e9e;margin:0;">تنفيذ المشاريع وفق أعلى المعايير وأفضل الممارسات العالمية.</p>
                </div>
                <div class="loft-card3d" style="padding:44px 32px;text-align:right;">
                    <div class="loft-icon-box" style="margin-right:0;margin-bottom:24px;">
                        <i class="fa fa-handshake-o" aria-hidden="true"/>
                    </div>
                    <h3 style="font-size:18px;font-weight:800;color:#2e465f;margin:0 0 10px;">النزاهة والالتزام</h3>
                    <p style="font-size:14px;line-height:1.9;color:#9e9e9e;margin:0;">بناء علاقات طويلة الأمد قائمة على الثقة مع عملائنا.</p>
                </div>
                <div class="loft-card3d" style="padding:44px 32px;text-align:right;">
                    <div class="loft-icon-box" style="margin-right:0;margin-bottom:24px;">
                        <i class="fa fa-lightbulb-o" aria-hidden="true"/>
                    </div>
                    <h3 style="font-size:18px;font-weight:800;color:#2e465f;margin:0 0 10px;">الابتكار والاستدامة</h3>
                    <p style="font-size:14px;line-height:1.9;color:#9e9e9e;margin:0;">تقديم حلول حديثة تراعي المستقبل وتواكب تطلعات السوق.</p>
                </div>
            </div>
        </div>
    </section>
</template>

<template id="loft_contact_strip" name="Loft Contact Strip">
    <section style="padding:80px 0;background:#1f2d3a;" dir="rtl" lang="ar">
        <div style="max-width:1180px;margin:0 auto;padding:0 24px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:24px;">
            <div class="loft-stat-card" style="text-align:center;flex-shrink:0;padding:28px 40px;min-width:260px;">
                <div style="font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#9e9e9e;margin-bottom:8px;">الهاتف</div>
                <div t-if="website.company_id.phone"
                     t-esc="website.company_id.phone"
                     style="font-size:28px;font-weight:800;color:#82aac8;letter-spacing:0.5px;"/>
                <div t-else=""
                     style="font-size:28px;font-weight:800;color:#82aac8;letter-spacing:0.5px;">
                    —
                </div>
            </div>
            <div class="loft-stat-card" style="flex:1;min-width:220px;padding:28px 32px;text-align:right;background:linear-gradient(145deg,#ffffff 0%,#f4f4f4 100%);">
                <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#82aac8;margin-bottom:8px;">البريد الإلكتروني</div>
                <div t-if="website.company_id.email"
                     style="font-size:20px;font-weight:700;color:#2e465f;">
                    <a t-att-href="'mailto:%s' % website.company_id.email"
                       t-esc="website.company_id.email"
                       style="text-decoration:none;color:inherit;"/>
                </div>
                <div t-else="" style="font-size:20px;font-weight:700;color:#2e465f;">—</div>
            </div>
            <div class="loft-stat-card" style="flex:1;min-width:260px;padding:28px 32px;text-align:right;background:linear-gradient(145deg,#ffffff 0%,#f4f4f4 100%);">
                <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#82aac8;margin-bottom:8px;">العنوان</div>
                <div t-if="website.company_id.partner_id"
                     style="font-size:15px;font-weight:600;line-height:1.6;color:#2e465f;">
                    <t t-set="partner" t-value="website.company_id.partner_id"/>
                    <t t-esc="', '.join([x for x in [partner.street, partner.street2, partner.city, partner.zip, partner.country_id and partner.country_id.name] if x])"/>
                </div>
                <div t-else="" style="font-size:15px;font-weight:600;line-height:1.6;color:#2e465f;">—</div>
            </div>
        </div>
    </section>
</template>

<template id="page_home" name="Loft Construction — Home">
    <t t-call="website.layout">
        <t t-set="title">Loft Construction — General Contracting &amp; Renovation</t>
        <t t-call="yd_website_loft.loft_assets"/>
        <div id="wrap" style="background:#f4f4f4;color:#2e465f;font-family:'Inter','Helvetica Neue',sans-serif;overflow-x:hidden;">

            <section class="loft-hero-lines" style="position:relative;min-height:94vh;display:flex;align-items:center;background:linear-gradient(135deg,#f4f4f4 0%,#eceff2 40%,#dde5eb 100%);overflow:hidden;">
                <div class="loft-hero-grid" style="position:absolute;inset:0;opacity:0.65;"/>
                <div style="position:absolute;top:-80px;left:-80px;width:320px;height:320px;background:radial-gradient(circle,rgba(130,170,200,0.16) 0%,transparent 72%);border-radius:50%;"/>
                <div style="position:absolute;bottom:-120px;right:-40px;width:360px;height:360px;background:radial-gradient(circle,rgba(46,70,95,0.08) 0%,transparent 75%);border-radius:50%;"/>
                <div style="position:relative;z-index:1;max-width:1180px;margin:0 auto;padding:0 24px;width:100%;">
                    <div style="max-width:700px;">
                        <t t-call="yd_website_loft.loft_eyebrow">
                            <t t-set="text">LOFT FOR BUILDING CONSTRUCTION</t>
                        </t>
                        <h1 class="loft-hero-title" style="font-size:68px;font-weight:800;line-height:1.02;letter-spacing:-2px;margin:0 0 26px;color:#2e465f;text-transform:uppercase;max-width:760px;">
                            LOFT <br/>Construction
                        </h1>
                        <p style="font-size:17px;line-height:1.9;color:#6f7c88;max-width:560px;margin:0 0 40px;">
                            شركة لوفت للمقاولات العامة هي شركة متخصصة في قطاع التشييد والبناء، وتعمل في دولة الكويت منذ عام 2019. منذ تأسيسها، سعت الشركة إلى أن تكون شريكاً موثوقاً في تنفيذ المشاريع المعمارية الحديثة.
                        </p>
                    </div>
                </div>
                <div style="position:absolute;bottom:0;left:0;right:0;transform:translateY(-10%);z-index:4;">
                    <div style="max-width:1180px;margin:0 auto;padding:0 24px;">
                        <div class="loft-stats-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;align-items:stretch;">
                            <div class="loft-stat-card" style="padding:34px 24px 30px;text-align:center;">
                                <div class="loft-stat-number">تأسست في الكويت</div>
                            </div>
                            <div class="loft-stat-card" style="padding:34px 24px 30px;text-align:center;">
                                <div class="loft-stat-number">الجودة والاحترافية</div>
                            </div>
                            <div class="loft-stat-card" style="padding:34px 24px 30px;text-align:center;">
                                <div class="loft-stat-number"> النزاهة والالتزام</div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section style="padding:250px 0 120px;background:#f4f4f4;">
                <div class="loft-about-grid" style="max-width:1180px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:0.42fr 1.58fr;gap:64px;align-items:center;">
                    <div class="loft-card3d" style="display:flex;align-items:center;justify-content:center;padding:36px;aspect-ratio:1/1;">
                       <img src="/logo.png" alt="Loft Construction Logo" style="max-width:100%;max-height:100%;object-fit:contain;filter:grayscale(1) invert(1) brightness(1.15);"/>
                    </div>
                    <div dir="rtl" lang="ar" style="text-align:right;">
                        <t t-call="yd_website_loft.loft_eyebrow">
                            <t t-set="text">من نحن</t>
                        </t>
                        <h2 style="font-size:32px;font-weight:800;color:#2e465f;line-height:1.5;margin:0 0 22px;">
                            شركة لوفت للمقاولات العامة
                        </h2>
                        <p style="font-size:16px;line-height:2;color:#9e9e9e;margin:0 0 16px;">
